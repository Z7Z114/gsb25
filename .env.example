# 复制为 .env 后按需填写；外部服务全部留空时后端走离线分支，可完全离线运行。

DATABASE_URL=sqlite:///./insect_protein.db
UPLOAD_DIR=./uploads
CLEANED_DIR=./cleaned

# 可选：OpenAI 纪要生成（留空则走确定性离线纪要）
OPENAI_API_KEY=

# 可选：pyannote 说话人区分（留空则不做说话人区分）
PYANNOTE_AUTH_TOKEN=

# 可选：Whisper 模型规格（需要 openai-whisper，见 requirements-ml.txt）
WHISPER_MODEL=medium

# 可选：SMTP 邮件（留空则投递失败并记录失败原因）
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
